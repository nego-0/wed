# ============================================================
# .htaccess — Endurecimento básico (Apache / InfinityFree)
# ============================================================

# --- Segredos e ficheiros internos -------------------------
# Se o PHP falhar ou for desativado numa manutenção, os .php passam a ser
# servidos como texto simples. Isto impede que as credenciais apareçam.
<FilesMatch "^(config\.local\.php|config\.local\.example\.php)$">
  Require all denied
</FilesMatch>

# Ficheiros de apoio que não têm de ser públicos
<FilesMatch "^(LEIA-ME\.md|.*\.log|.*\.sql|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# Nunca servir ficheiros de controlo de versões / editores
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- O endereço do bar de cada festa ------------------------
# `bebidas-2026-12-19-ia.php` é o link que o casal dá aos convidados: vai no
# convite, no grupo da família, num cartaz à entrada. Lê-se, dita-se e
# reconhece-se — quem o vê sabe de que festa é. Por baixo é a bebidas.php de
# sempre, com o endereço a dizer qual é o casamento.
#
# O QSA guarda o que vier a seguir: quem entra pelo QR de uma mesa traz um
# `?m=CÓDIGO`, e esse continua a dizer para onde levar a bebida.
#
# Se o mod_rewrite não estiver ligado, nada disto acontece e a forma
# `bebidas.php?c=2026-12-19-ia` continua a abrir a mesma página — é por isso
# que a página aceita as duas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^bebidas-([A-Za-z0-9-]+)\.php$ bebidas.php?c=$1 [QSA,L]
</IfModule>

# --- Cabeçalhos de segurança --------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # A câmara é precisa na página do porteiro (leitura de QR); o resto fica fechado.
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=()"
</IfModule>

# --- Cache dos recursos estáticos ---------------------------
# Tipos de letra e bibliotecas não mudam: evita voltar a descarregá-los.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType audio/mp4               "access plus 30 days"
</IfModule>

# O service worker tem de ser sempre verificado, senão fica preso a uma versão.
<FilesMatch "^sw\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# --- Compressão ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Sem listagem de diretórios
Options -Indexes
